@using WebApplication.Core.Helper;
<!-- Add this before </body> -->
<script src="https://www.google.com/recaptcha/api.js" async defer></script>
<!--============================
        About Page Header
    =============================-->
<section class="page-header">
    <div class="container">
        <div class="row">
            <div class="col-sm-12">
                <h1>Contact Us</h1>
                <ul class="list-unstyled">
                    <li><a href="@Url.Action("Index","Home")">Home</a></li>
                    <li class="active">Contact Us</li>
                </ul>
            </div>
        </div>
    </div>
</section>
<!-- Ends: .page-header -->
<!--============================
        About Page Content
    =============================-->
<section class="contact-wrapper">
    <div class="container">
        <div class="row">
            <div class="contact-two-top row">
                <div class="col-sm-7">
                    <div class="col-sm-12">
                        <div class="contact-info row">
                            <div class="col-sm-12">
                                <h1>Get in Touch</h1>
                                <div class="h20"></div>
                            </div>
                            <div class="col-sm-12">
                                <div class="contact-info-box">
                                    <div class="icon"><i class="fa fa-map-marker"></i></div>
                                    <div class="cinfo">
                                        <h4>HVM Convent School</h4>
                                        <p> HVM Convent School Ludhiana is Affiliated with C.B.S.E. New Delhi. School code 20632 & Affiliation No. 1630652. </p>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                    <div class="col-sm-12">
                        <div class="contact-info row">
                            <div class="col-sm-12">
                                <div class="contact-info-box">
                                    <div class="icon"><i class="fa fa-map-marker"></i></div>
                                    <div class="cinfo">
                                        <h4>The Office</h4>
                                        <p><strong>Address:</strong> Karamsar Colony, New Subash Nagar,Ludhiana, Punjab. School No:20632</p>
                                    </div>
                                </div>
                            </div>
                            <div class="col-sm-6">
                                <div class="contact-info-box">
                                    <div class="icon"><i class="fa fa-phone"></i></div>
                                    <div class="cinfo">
                                        <h4>Phone</h4>
                                        <p>94640-98888</p>
                                        <p>98150-98888</p>
                                    </div>
                                </div>
                            </div>
                            <div class="col-sm-6">
                                <div class="contact-info-box">
                                    <div class="icon"><i class="fa fa-envelope"></i></div>
                                    <div class="cinfo">
                                        <h4>Email</h4>
                                        <p><a href="mailto:hvmconvent@gmail.com">hvmconvent@gmail.com</a></p>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
                <div id="contact-focus" class="col-sm-5">
                    <div class="contact-one-form">
                        <h1>Write Your Message Here</h1>
                        <form id="ajax-contact" action="../../@Url.Action("ContactUs","Home")" method="post">
                            <div class="form-group row">
                                <div class="col-sm-6">
                                    <input type="text" name="Name" placeholder="Name *" required>
                                </div>
                                <div class="col-sm-6">
                                    <input type="email" name="Email" placeholder="Email *" required>
                                </div>
                                <div class="col-sm-12">
                                    <input type="number" name="Subject" placeholder="Mobile No. *" required>
                                </div>
                                <div class="col-sm-12">
                                    <textarea placeholder="Message" name="Message" required></textarea>
                                </div>
                                <!-- Add reCAPTCHA here -->
                                <div class="col-sm-12 mb-3"  style="padding-bottom: 25px;">
                                    <div class="g-recaptcha" data-sitekey="@AppSetting.CaptchaSite"></div>
                                </div>
                                <div class="col-sm-12">
                                    <button id="contact-us" type="button" onclick="validateForm()">Send Message</button>
                                    <button id="submit" type="submit" style="display:none"></button>
                                </div>
                            </div>
                        </form>
                    </div>
                    <!-- Ends: .contact-one-form -->
                    <div class="clear h20"></div>
                    <!-- Ends: .col-sm-6 -->
                    <!-- Ends: .col-sm-6 -->
                </div>
                <div class="col-sm-12">
                    <div class="contact-map">
                        <h3>Location On Map</h3>
                        <iframe src="https://maps.google.com/maps?width=100%25&amp;height=600&amp;hl=en&amp;q=HVM%20Convent%20school%20ludhiana+(My%20Business%20Name)&amp;t=&amp;z=14&amp;ie=UTF8&amp;iwloc=B&amp;output=embed" width="100" height="350"></iframe>
                    </div>
                </div>
                <!-- Ends: .col-sm-12 -->
                <div class="clear h20"></div>
            </div>
        </div>
    </div>
</section>
<script src="https://code.jquery.com/jquery-1.11.0.min.js"></script>
