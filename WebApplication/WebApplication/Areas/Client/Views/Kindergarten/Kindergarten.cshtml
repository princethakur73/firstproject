@using System.Linq;
@using WebApplication.Infrastructure
@{
    Layout = "~/Areas/Client/Views/Shared/_Layout.cshtml";
}
@section seo
{
    <meta name="description" content="@Model.MetaDescription">
    <meta name="keywords" content="@Model.MetaKeywords">
}
@{
    var dbContext = Context.GetContainer().GetInstance<WebApplication.Service.ISlideService>();
    var slides = dbContext.GetList(currentUserId: 0).Where(a=>a.Type==2).OrderBy(m => m.SortId);
}
<script src="https://code.jquery.com/jquery-1.11.0.min.js"></script>

<link href="~/Content/Client/Index/Index.css" rel="stylesheet" />
<style>
    .facilities {
        border-radius: 5px;
        border: 1px solid black;
        margin-bottom: 10px;
    }

    .caption {
        margin-top: 200px
    }
    /**Slider**/
    .our-infrastruture {
    }

        .our-infrastruture > div {
            position: absolute;
            top: 0px;
            left: 10px;
            right: 10px;
            bottom: 10px;
        }
    /**Kindergardten **/
    img.img-fluid.mb-2 {
        width: 100%;
    }

    /* Kindergarten Page Styles */
    .kg-section {
        padding: 4rem 0;
    }

    .kg-section-alt {
        background: #f9f9f9;
    }

    .kg-hero {
        background: #fffbe7;
        padding: 5rem 0;
    }

    .kg-heading {
        color: #c40e05;
        margin-bottom: 2rem;
    }

    .kg-card {
        border: none;
        transition: transform 0.3s ease;
        border-radius: 10px;
    }

        .kg-card:hover {
            transform: translateY(-5px);
        }

    .kg-icon {
        color: #e9887f;
        font-size: 2.5rem;
        margin-bottom: 1rem;
    }

    .kg-activity-item {
        margin-bottom: 2rem;
    }

        .kg-activity-item img {
            border-radius: 10px;
            margin-bottom: 1rem;
            transition: transform 0.3s ease;
        }

            .kg-activity-item img:hover {
                transform: scale(1.05);
            }

    .kg-testimonial {
        background: #fff;
        padding: 2rem;
        border-radius: 10px;
        box-shadow: 0 4px 6px rgba(0,0,0,0.1);
    }

    .contact-btn-theme {
        background: #c40e05;
        color: #fff;
        padding: 0.8rem 2rem;
        border-radius: 30px;
        transition: all 0.3s ease;
    }

        .contact-btn-theme:hover {
            background: #a50b04;
            color: #fff;
            transform: translateY(-2px);
        }

    .fade-in {
        opacity: 0;
        transform: translateY(20px);
        transition: opacity 0.6s ease, transform 0.6s ease;
    }

        .fade-in.visible {
            opacity: 1;
            transform: translateY(0);
        }
</style>

